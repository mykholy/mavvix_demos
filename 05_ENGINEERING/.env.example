# Mavvix Demo Factory V2 example (NEVER fill with secrets in this ZIP)
NEXT_PUBLIC_MAVVIX_SALES_URL=https://mavvix.com/
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_MODE=true
# Full V2 working mode REQUIRES true on persistent Node hosting with private disk.
DEMO_PERSISTENCE_ENABLED=true
SQLITE_DB_PATH=./data/mavvix-demo.sqlite
# Configure these locally using secrets manager / local .env; never commit actual values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
AUTH_SESSION_SECRET=
# Request TTL in days, demo synthetic content only
DEMO_SUBMISSION_TTL_DAYS=7
